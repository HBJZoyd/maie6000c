# Keep captured evidence byte-identical to its SHA-256 manifest on Windows.
submissions/week07/evidence/** -text whitespace=-blank-at-eol,-blank-at-eof
submissions/week07/assets/** -text
submissions/week07/*.pptx binary
submissions/week07/*.md text eol=lf
submissions/week07/ARTIFACT_MANIFEST.json text eol=lf

